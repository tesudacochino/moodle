# =============================================================================
# MOODLE DOCKER — Variables de entorno
# =============================================================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
#
# ¡NUNCA subas el .env real a git!
# =============================================================================

# -----------------------------------------------------------------------------
# Versión de Moodle
# -----------------------------------------------------------------------------
# Rama estable de GitHub a usar en el build.
# Ver lista completa: https://github.com/moodle/moodle/branches
#
# Opciones comunes:
#   MOODLE_405_STABLE  → Moodle 4.5.x (LTS actual - RECOMENDADO)
#   MOODLE_404_STABLE  → Moodle 4.4.x
#   MOODLE_403_STABLE  → Moodle 4.3.x
#
# Para actualizar: cambia este valor y ejecuta: make rebuild
MOODLE_VERSION=MOODLE_405_STABLE

# Versión de PHP de la imagen base (moodlehq/moodle-php-apache)
PHP_VERSION=8.4

# -----------------------------------------------------------------------------
# URL y acceso a Moodle
# -----------------------------------------------------------------------------
# ¡IMPORTANTE! Debe coincidir exactamente con la URL pública (con https:// en producción)
MOODLE_WWWROOT=https://moodle.tudominio.com

# Activar si Moodle está detrás de un Nginx/proxy que termina SSL
# OBLIGATORIO cuando MOODLE_WWWROOT empieza por https://
MOODLE_SSLPROXY=true

# Puerto HTTP del host (solo accesible internamente; Nginx del host hace el SSL)
HTTP_PORT=8080

# Nombre del sitio
MOODLE_SITE_NAME=My Moodle Site

# Idioma por defecto (es, en, fr, de, ...)
MOODLE_LANG=es

# -----------------------------------------------------------------------------
# Credenciales del administrador (solo usadas en la primera instalación)
# -----------------------------------------------------------------------------
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin1234!
MOODLE_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=moodle
DB_USER=moodle
DB_PASS=moodle_secure_password_change_me
DB_PREFIX=mdl_

# -----------------------------------------------------------------------------
# Despliegue desde Docker Hub (docker-compose.deploy.yml)
# -----------------------------------------------------------------------------
# Usuario de Docker Hub donde está publicada la imagen
DOCKERHUB_USERNAME=tesudacochino

# Tag de la imagen a desplegar:
#   latest              → siempre el build más reciente
#   4.5                 → versión semántica
#   MOODLE_405_STABLE   → rama exacta de Moodle
# Recomiendado en producción: pinear a un tag específico (no latest)
MOODLE_IMAGE_TAG=latest
