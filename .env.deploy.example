# =============================================================================
# MOODLE DOCKER — Variables de entorno para DESPLIEGUE (producción/staging)
# =============================================================================
# Usado con: docker-compose.deploy.yml
# No se necesita build local — la imagen se descarga de Docker Hub.
#
# Uso:
#   cp .env.deploy.example .env
#   # Editar los valores marcados con ← CAMBIAR
#   docker compose -f docker-compose.deploy.yml up -d
#
# ¡NUNCA subas el .env real a git!
# =============================================================================

# -----------------------------------------------------------------------------
# Imagen Docker Hub
# -----------------------------------------------------------------------------
# Usuario de Docker Hub donde está publicada la imagen
DOCKERHUB_USERNAME=molero

# Tag de la imagen a desplegar.
# ⚠️  En producción: pinear siempre a un tag específico, nunca 'latest'
#
#   latest              → siempre el build más reciente (NO recomendado en prod)
#   5.0                 → Moodle 5.0.x (semántico)
#   MOODLE_500_STABLE   → rama exacta
MOODLE_IMAGE_TAG=5.0

# -----------------------------------------------------------------------------
# URL pública de Moodle
# -----------------------------------------------------------------------------
# ¡CRÍTICO! Debe coincidir exactamente con la URL que verán los usuarios.
# Moodle usa este valor para generar todos sus enlaces internos.
MOODLE_WWWROOT=https://moodle.tudominio.com        # ← CAMBIAR

# Puerto interno que expone el contenedor en el host.
# El Nginx del host redirige hacia este puerto.
# No cambiar si Nginx ya apunta al 8080.
HTTP_PORT=8080

# Activar cuando Nginx del host termina el SSL (HTTPS).
# OBLIGATORIO cuando MOODLE_WWWROOT empieza por https://
MOODLE_SSLPROXY=true

# -----------------------------------------------------------------------------
# Sitio Moodle
# -----------------------------------------------------------------------------
MOODLE_SITE_NAME=My Moodle Site                    # ← CAMBIAR
MOODLE_LANG=es

# -----------------------------------------------------------------------------
# Credenciales del administrador
# Solo se usan en la PRIMERA instalación. Después cámbialas desde la UI.
# -----------------------------------------------------------------------------
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=CambiaMeAhora2024!               # ← CAMBIAR — mínimo 8 caracteres
MOODLE_ADMIN_EMAIL=admin@tudominio.com             # ← CAMBIAR

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
DB_NAME=moodle
DB_USER=moodle
DB_PASS=password_seguro_cambiar                    # ← CAMBIAR — usa una contraseña fuerte
DB_PREFIX=mdl_

# -----------------------------------------------------------------------------
# Configuración de Correo SMTP (Opcional)
# -----------------------------------------------------------------------------
# SMTP_HOSTS=smtp.example.com:587
# SMTP_USER=usuario@example.com
# SMTP_PASS=contrasena_secreta
# SMTP_SECURE=tls
# SMTP_AUTHTYPE=LOGIN
# SMTP_NOREPLY_ADDRESS=noreply@example.com
# SMTP_SUPPORT_EMAIL=soporte@example.com

